{
  "entities": {
    "category": {
      "title": "Category",
      "description": "Custom or default category for grouping prompts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the category"
        },
        "icon": {
          "type": "string",
          "description": "Emoji icon representation"
        },
        "name": {
          "type": "string",
          "description": "Display name in Vietnamese"
        },
        "description": {
          "type": "string",
          "description": "Mô tả phòng khoa (ví dụ: Khu tập trung chăm sóc các ca bệnh...)"
        },
        "location": {
          "type": "string",
          "description": "Vị trí phòng khoa (ví dụ: Phòng Thường Niên - Lầu II - Chữa Lành)"
        }
      },
      "required": ["id", "icon", "name"]
    },
    "prompt": {
      "title": "Prompt",
      "description": "A doctor, nurse, or medical staff profile with customizable avatar, details, and optional passcode lock",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Numeric or unique ID for the prompt"
        },
        "name": {
          "type": "string",
          "description": "Profile name"
        },
        "category": {
          "type": "string",
          "description": "Linked category ID"
        },
        "icon": {
          "type": "string",
          "description": "Visual character emoji representation"
        },
        "url": {
          "type": "string",
          "description": "Underlying link or source reference URL"
        },
        "description": {
          "type": "string",
          "description": "Character profile introduction or system message"
        },
        "tags": {
          "type": "array",
          "description": "Attributes or characteristics tags"
        },
        "hasPassword": {
          "type": "boolean",
          "description": "Whether passcode protection is enabled"
        },
        "hint": {
          "type": "string",
          "description": "Password hint text"
        },
        "password": {
          "type": "string",
          "description": "Custom password text value"
        },
        "passwordFailLimit": {
          "type": "number",
          "description": "Max allowable password failed attempts before the central troll overlay gets triggered"
        },
        "passwordFailGifUrl": {
          "type": "string",
          "description": "Custom link or Base64 data URI of a troll media image, GIF, or video"
        },
        "passwordFailSoundUrl": {
          "type": "string",
          "description": "Custom link or Base64 data URI of a siren/alarm sound warning"
        }
      },
      "required": ["id", "name", "category", "icon", "url", "description", "tags"]
    },
    "medicalRecord": {
      "title": "Medical Record",
      "description": "Hospital record or clinical symptom note submitted by a visiting client",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Unique record identifier number"
        },
        "name": {
          "type": "string",
          "description": "Patient user custom identifier"
        },
        "age": {
          "type": "string",
          "description": "Target demographic segment name / range"
        },
        "cat": {
          "type": "string",
          "description": "Primary affected mental or neurological category"
        },
        "note": {
          "type": "string",
          "description": "Patient description of delusion or symptoms"
        },
        "symptoms": {
          "type": "array",
          "description": "Collection of checked clinical symptom names"
        },
        "date": {
          "type": "string",
          "description": "ISO date string representing check-in"
        }
      },
      "required": ["id", "name", "age", "cat", "note", "symptoms", "date"]
    },
    "config": {
      "title": "Config",
      "description": "System configurations such as maintenance mode",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether maintenance mode is active"
        }
      },
      "required": ["enabled"]
    },
    "feedback": {
      "title": "Feedback",
      "description": "Patient reviews and comments left for specific prompts/nurses",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique feedback ID"
        },
        "promptId": {
          "type": "number",
          "description": "Linked doctor/nurse prompt identifier"
        },
        "author": {
          "type": "string",
          "description": "Patient pseudonym or Anonymous name"
        },
        "comment": {
          "type": "string",
          "description": "Detailed comment, suggestion, or warm greetings"
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5 stars"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO date-time or formatted string representing submission"
        },
        "isReported": {
          "type": "boolean",
          "description": "Flag indicating if this feedback was reported by a user"
        },
        "reportedReason": {
          "type": "string",
          "description": "Reason for report, if any"
        },
        "reportedAt": {
          "type": "string",
          "description": "Timestamp of report"
        },
        "adminReply": {
          "type": "string",
          "description": "Official admin response to this review"
        },
        "adminReplyAt": {
          "type": "string",
          "description": "Timestamp of admin reply"
        },
        "adminReplyAuthor": {
          "type": "string",
          "description": "Title or name of admin responding"
        }
      },
      "required": ["id", "promptId", "author", "comment", "rating", "timestamp"]
    },
    "notification": {
      "title": "Admin Notification",
      "description": "System alerts and feedback notifications for administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique notification ID" },
        "type": { "type": "string", "description": "Type of event (feedback, report, etc.)" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Short message preview" },
        "promptId": { "type": "string", "description": "Associated character/prompt ID if applicable" },
        "promptName": { "type": "string", "description": "Name of character/prompt" },
        "author": { "type": "string", "description": "Author who triggered notification" },
        "timestamp": { "type": "string", "description": "ISO creation timestamp" },
        "read": { "type": "boolean", "description": "Whether admin has read this alert" }
      },
      "required": ["id", "type", "title", "message", "timestamp", "read"]
    },
    "weeklyVote": {
      "title": "Weekly Vote Tally",
      "description": "Record of votes for staff members partitioned by week (Mon-Sun)",
      "type": "object",
      "properties": {
        "weekKey": { "type": "string", "description": "Formatted week identifier like 2026-W45" },
        "votes": { "type": "object", "description": "Mapping from characterId to vote count" },
        "winnerId": { "type": "string", "description": "ID of leading/winning character" },
        "winnerName": { "type": "string", "description": "Name of winner" },
        "winnerVotes": { "type": "number", "description": "Top vote count" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["weekKey", "votes"]
    },
    "loungePost": {
      "title": "Sảnh Khoe Post",
      "description": "Community lounge post shared by patients or staff",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique post ID" },
        "author": { "type": "string", "description": "Custom pseudonym chosen for this post" },
        "content": { "type": "string", "description": "Post body text up to 1000 words" },
        "tag": { "type": "string", "description": "Category tag like Khoe Quà, Tâm Sự, Cảm Ơn, Góp Ý" },
        "images": { "type": "array", "description": "Up to 4 compressed photo data URLs" },
        "reactions": { "type": "object", "description": "Reaction count tallies by emoji key" },
        "commentsCount": { "type": "number", "description": "Total replies count" },
        "isPinned": { "type": "boolean", "description": "Whether post is pinned to top of lounge" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" }
      },
      "required": ["id", "author", "content", "createdAt"]
    },
    "loungeComment": {
      "title": "Sảnh Khoe Comment",
      "description": "Reply comment on a lounge post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique comment ID" },
        "postId": { "type": "string", "description": "Target post ID" },
        "author": { "type": "string", "description": "Display nickname" },
        "content": { "type": "string", "description": "Comment content text" },
        "isAdmin": { "type": "boolean", "description": "Whether comment is from authenticated admin" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "postId", "author", "content", "createdAt"]
    }
  },
  "firestore": {
    "categories": {
      "schema": "category",
      "description": "Collection storing active prompt classification categories"
    },
    "prompts": {
      "schema": "prompt",
      "description": "Online database of characters, prompts, and profiles"
    },
    "phdRecords": {
      "schema": "medicalRecord",
      "description": "Online database storing registered medical check-in records"
    },
    "config": {
      "schema": "config",
      "description": "System configuration documents"
    },
    "feedbacks": {
      "schema": "feedback",
      "description": "Patient feedback and evaluation collection"
    },
    "admin_notifications": {
      "schema": "notification",
      "description": "Notifications and alerts for administration staff"
    },
    "weekly_votes": {
      "schema": "weeklyVote",
      "description": "Weekly voting scores and honors"
    },
    "lounge_posts": {
      "schema": "loungePost",
      "description": "Community lounge forum posts for Sảnh Khoe"
    },
    "lounge_comments": {
      "schema": "loungeComment",
      "description": "Replies and discussions on lounge posts"
    },
    "settings": {
      "schema": "setting",
      "description": "Application preferences and settings"
    }
  }
}
